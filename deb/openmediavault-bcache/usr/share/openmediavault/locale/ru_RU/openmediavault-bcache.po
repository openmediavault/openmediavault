msgstr "Снято с регистрации"

msgid "Unused"
msgstr "Не используется"

msgid "Updated backing device '{{ devicefile }}'."
msgstr "Обновлено основное устройство «{{ devicefile }}»."

msgid "Updated cache device '{{ devicefile }}'."
msgstr "Обновлено кэш-устройство «{{ devicefile }}»."

msgid ""
"When dirty data is written to the cache and it previously did not contain "
"any, waits some number of seconds before initiating writeback. (default:30)"
msgstr ""
"Когда в кэш записываются грязные данные, которых в нём ранее не было, перед "
"началом обратной записи ожидается указанное число секунд (по умолчанию: 30)."

msgid "Writeback Delay"
msgstr "Задержка обратной записи"

msgid "Writeback Percent"
msgstr "Процент обратной записи"

msgid "none"
msgstr "нет"

msgid "writearound"
msgstr "обход записи"

msgid "writeback"
msgstr "обратная запись"

msgid "writethrough"
msgstr "сквозная запись"
