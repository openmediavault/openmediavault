msgstr "Кэш-устройство"

msgid "Cache Devices"
msgstr "Кэш-устройства"

msgid "Cache Mode"
msgstr "Режим кэша"

msgid "Capacity"
msgstr "Ёмкость"

msgid "Clean"
msgstr "В порядке"

msgid "Clear total statistics"
msgstr "Очистить общую статистику"

msgid "Configuration"
msgstr "Конфигурация"

msgid "Congest Tracking"
msgstr "Отслеживание перегрузки"

msgid "Congested Read Threshold (us)"
msgstr "Порог перегрузки при чтении (мкс)"

msgid "Create"
msgstr "Создать"

