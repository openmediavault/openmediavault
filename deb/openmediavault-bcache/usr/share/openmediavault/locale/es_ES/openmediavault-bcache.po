msgid "5 Minutes"
msgstr "5 minutos"

msgid ""
"A sequential IO will bypass the cache once it passes this threshold. "
"(default:4.0M, max:3.9G)"
msgstr ""
"Una operación de E/S secuencial omitirá la caché una vez que supere este "
"umbral. (default:4.0M, max:3.9G)"

msgid ""
"Allow bcache go around the cache when there's read / write congestion. "
"(default:true)"
msgstr ""
"Permitir que bcache omita la caché cuando haya congestión de "
"lectura/escritura. (default:true)"

