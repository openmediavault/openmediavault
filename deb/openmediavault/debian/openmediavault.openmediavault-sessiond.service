[Unit]
Description=The openmediavault daemon that terminates outdated web UI sessions
After=local-fs.target

[Service]
Type=simple
User=openmediavault-webgui
Group=openmediavault-webgui
ExecStart=/usr/sbin/omv-sessiond
# Check the sessions immediately.
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
