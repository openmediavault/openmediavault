// Block the signals as early as possible, they are handled synchronously in
// the main loop. The default action of SIGUSR1 would terminate the process.
$signals = [ SIGUSR1, SIGTERM, SIGINT ];
pcntl_sigprocmask(SIG_BLOCK, $signals);

require_once("openmediavault/autoloader.inc");
require_once("openmediavault/globals.inc");
require_once("openmediavault/functions.inc");

// The role of a web UI session is set at login. This daemon periodically
// terminates the sessions of users that have been deleted or that are no
// longer administrators. Sessions with the role 'user' are not checked,
// a promotion is applied with the next login.
// The sessions are checked periodically to detect changes made outside of
// openmediavault (e.g. AD/LDAP). SIGUSR1 requests an immediate check, this
// is used by the engine if a user or group has been changed.

// Must match the directory configured for PHP-FPM.
const SESSION_DIR = "/run/openmediavault/sessions";

// Seconds after which a session that is not logged in is removed. This must
// be longer than the lifetime of a pending login.
const SESSION_UNAUTHENTICATED_TTL = \OMV\Session::PENDING_AUTH_TTL_SECONDS + 300;

function checkSessions()
{
    $adminGroup = \OMV\Environment::get("OMV_WEBGUI_ADMINGROUP_NAME");
    foreach (glob(SESSION_DIR . "/sess_*") as $file) {
        try {
            session_id(substr(basename($file), strlen("sess_")));
            $mtime = filemtime($file);
            // Close the session immediately to release the file lock. The
            // user checks below may take a while (e.g. AD/LDAP) and must
            // not block the web UI.
            session_start([ "read_and_close" => true ]);
            $data = $_SESSION;
            $_SESSION = [];
            // Skip sessions that are not logged in, e.g. a login that is
            // waiting for the response of an authentication challenge.
            // Every request without a login creates such a session, thus
            // remove them if they are stale.
            if (true !== array_value($data, "authenticated", false)) {
                if ((false !== $mtime) &&
                        ((time() - $mtime) > SESSION_UNAUTHENTICATED_TTL)) {
                    session_start();
                    session_destroy();
                }
                continue;
            }
            // Keep the session if the user still exists and, in case of an
            // administrator session, is still a member of the admin group.
            $user = new \OMV\System\User($data['username']);
            if ($user->exists() && ((OMV_ROLE_ADMINISTRATOR !== $data['role']) ||
                    in_array($adminGroup, $user->getGroups()))) {
                continue;
            }
            // Reopen the session, session_destroy() needs an active one.
            session_start();
            session_destroy();
            syslog(LOG_NOTICE, sprintf(
                "Terminated the session of user '%s'",
                $data['username']
            ));
        } catch (\Throwable $e) {
            // Never terminate a session if the check itself has failed,
            // e.g. because the group membership could not be resolved.
            syslog(LOG_ERR, sprintf(
                "Failed to check the session '%s': %s",
                basename($file),
                $e->getMessage()
            ));
        }
    }
}

openlog(basename($argv[0]), LOG_PID, LOG_USER);

// Do not send cookies or headers, this is no web request. Without an empty
// cache limiter session_start() fails once anything has been printed.
ini_set("session.use_cookies", 0);
ini_set("session.cache_limiter", "");
session_save_path(SESSION_DIR);

$interval = max(1, \OMV\Environment::getInteger(
    "OMV_WEBGUI_SESSION_CHECK_INTERVAL",
    300
));
do {
    checkSessions();
    // Wait for the next check. A SIGUSR1 that arrives during a check is
    // not lost, it stays pending and starts the next check immediately.
    $signal = pcntl_sigtimedwait($signals, $info, $interval);
} while (!in_array($signal, [ SIGTERM, SIGINT ], true));

closelog();
exit(0);
