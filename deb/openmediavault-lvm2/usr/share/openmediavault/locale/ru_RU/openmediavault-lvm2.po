msgid "Active"
msgstr "Активный"

msgid "Available"
msgstr "Доступно"

msgid "Capacity"
msgstr "Емкость"

msgid "Create"
msgstr "Создать"

msgid "Created logical volume '{{ name }}'."
msgstr "Логический том «{{ name }}» создан."

msgid "Created physical volume {{ devicefile }}."
msgstr "Физический том {{ devicefile }} создан."

msgid "Created snapshot of logical volume '{{ devicefile }}'."
msgstr "Создан снимок логического тома «{{ devicefile }}»."

msgid "Created volume group '{{ name }}'."
msgstr "Группа томов «{{ name }}» создана."

msgid "Device"
msgstr "Устройство"

msgid "Devices"
msgstr "Устройства"

msgid "Do you really want to create a physical volume on '{{ devicefile }}'?"
msgstr "Вы действительно хотите создать физический том на «{{ devicefile }}»?"

msgid "Do you really want to resize the selected physical volume?"
msgstr "Вы действительно хотите изменить выбранный физический том?"

msgid "Edit"
msgstr "Редактировать"

msgid "Extend"
msgstr "Увеличить"

msgid "Extended logical volume '{{ devicefile }}'."
msgstr "Логический том «{{ devicefile }}» расширен."

msgid "Extended volume group '{{ devicefile }}'."
msgstr "Группа томов «{{ devicefile }}» расширена."

msgid "Free"
msgstr "Свободно"

msgid "Invalid name"
msgstr "Недопустимое имя"

msgid "LVM"
msgstr "LVM"

msgid "Logical Volume Management"
msgstr "Управление логическими томами"

msgid "Logical Volumes"
msgstr "Логические тома"

msgid "Max. capacity"
msgstr "Макс. ёмкость"

msgid "Name"
msgstr "Имя"

msgid "New capacity"
msgstr "Новая ёмкость"

msgid "Percentage"
msgstr "Процент"

msgid "Physical Volumes"
msgstr "Физические тома"

msgid "Please wait, a snapshot will be created ..."
msgstr "Подождите, создаётся снимок..."

msgid "Reduce"
msgstr "Уменьшить"

msgid "Reduced volume group '{{ devicefile }}'."
msgstr "Группа томов «{{ devicefile }}» уменьшена."

msgid "Referenced"
msgstr "Используется"

msgid "Resize"
msgstr "Изменить размер"

msgid "Select a device ..."
msgstr "Выберите устройство..."

msgid "Select a volume group ..."
msgstr "Выберите группу томов..."

msgid "Select devices ..."
msgstr "Выберите устройства..."

msgid "Select the devices used to extend the volume group."
msgstr "Выберите устройства, используемые для расширения группы томов."

msgid "Select the devices used to reduce from the volume group."
msgstr "Выберите устройства, которые нужно удалить из группы томов."

msgid "Size"
msgstr "Размер"

msgid "Snapshot"
msgstr "Снимок"

msgid "The name of the logical volume."
msgstr "Имя логического тома."

msgid "The name of the volume group."
msgstr "Имя группы томов."

msgid ""
"The percentage of the total space in the volume group to allocate for the "
"new logical volume."
msgstr "Процент от общего пространства группы томов, выделяемый для нового логического тома."

msgid ""
"The percentage of the total space in the volume group to use by the logical "
"volume."
msgstr "Процент от общего пространства группы томов, используемый логическим томом."

msgid "Updated logical volume '{{ devicefile }}'."
msgstr "Логический том «{{ devicefile }}» обновлён."

msgid "Updated volume group '{{ devicefile }}'."
msgstr "Группа томов «{{ devicefile }}» обновлена."

msgid "Used"
msgstr "Использованно"

msgid "Volume Group"
msgstr "Группа томов"

msgid "Volume Groups"
msgstr "Группы томов"

msgid "Volume group"
msgstr "Группа томов"
