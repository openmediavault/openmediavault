msgstr "Сертификат"

msgid "Enabled"
msgstr "Включено"

msgid "File Browser"
msgstr "File Browser"

msgid ""
"Get the auto-generated password after the service starts for the first time "
"by running <kbd>podman logs filebrowser-app | grep 'admin password'</kbd> in"
" the CLI."
msgstr ""
"Чтобы получить автоматически созданный пароль после первого запуска службы, "
"выполните в командной строке: <kbd>podman logs filebrowser-app | grep 'admin"
" password'</kbd>."

msgid "Open UI"
msgstr "Открыть интерфейс"

msgid "Port"
msgstr "Порт"

msgid "Port to listen on."
msgstr "Порт для прослушивания."

msgid "Shared folder"
msgstr "Общий каталог"

msgid "The SSL certificate."
msgstr "SSL-сертификат."

msgid ""
"The location of the media files. Make sure the user <em>filebrowser</em> or "
"group <em>users</em> can access the files."
msgstr ""
"Расположение медиафайлов. Убедитесь, что пользователь <em>filebrowser</em> "
"или группа <em>users</em> имеет доступ к файлам."

msgid "Updated File Browser settings."
msgstr "Настройки File Browser обновлены."
