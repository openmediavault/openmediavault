msgid ""
"The location of the media files. Make sure the user <em>filebrowser</em> or "
"group <em>users</em> can access the files."
msgstr ""
"Placering af media filerne. Vær sikker på at brugeren <em>filebrowser</em> "
"eller gruppe <em>users</em> kan tilgå filerne."

msgid "Updated File Browser settings."
msgstr "Opdateret Stifinder indstillinger."

msgid ""
"Use the <em>admin:admin</em> credentials when logging in for the first time."
" Please do not forget to change the password immediately."
msgstr ""
"Brug <em>admin:admin</em> identifikationsoplysningerne ved første login. "
"Venligst husk at ændre adgangskoden med det samme."
