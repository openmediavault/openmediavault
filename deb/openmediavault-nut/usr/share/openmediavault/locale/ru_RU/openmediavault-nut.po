msgid ""
"'Standalone' for local UPS, 'Netclient' for remote UPS on a NUT server."
msgstr "«Автономный» для локального ИБП, «Сетевой клиент» — для удалённого ИБП на сервере NUT."

msgid "Battery charge with the low-battery shutdown threshold marked."
msgstr "Заряд батареи с отмеченным порогом отключения при низком заряде"

msgid "Battery date"
msgstr "Дата батареи"

msgid "Battery low"
msgstr "Низкий заряд батареи"

msgid "Battery type"
msgstr "Тип батареи"

msgid "Battery voltage"
msgstr "Напряжение батареи"

msgid "Charge"
msgstr "Заряд"

msgid "Charge warning"
msgstr "Предупреждение о заряде"

msgid "Comment"
msgstr "Комментарий"

msgid "Date & Time"
msgstr "Дата и время"

msgid "Defines when the shutdown is initiated."
msgstr "Определяет, когда начинается отключение."

msgid "Driver configuration directives"
msgstr "Директивы конфигурации драйверов"

msgid "Enable remote monitoring of the local connected UPS."
msgstr "Включить удалённый мониторинг локально подключённого ИБП."

msgid "Enabled"
msgstr "Включено"

msgid "Identifier"
msgstr "Идентификатор"

msgid "Input voltage"
msgstr "Входное напряжение"

msgid "Invalid identifier"
msgstr "Недопустимый идентификатор"

msgid "Load"
msgstr "Загрузка"

msgid "Low"
msgstr "Низкий"

msgid "Manufacturer"
msgstr "Производитель"

msgid "Message"
msgstr "Сообщение"

msgid "Mode"
msgstr "Режим"

msgid "Model"
msgstr "Модель"

msgid "Netclient"
msgstr "Сетевой клиент"

msgid "Netclient hostname"
msgstr "Имя сетевого клиента"

msgid "Netclient password"
msgstr "Пароль сетевого клиента"

msgid "Netclient user name"
msgstr "Имя пользователя сетевого клиента"

msgid "PID"
msgstr "PID"

msgid "Password"
msgstr "Пароль"

msgid "Powervalue"
msgstr "Powervalue"

msgid "Program"
msgstr "Программа"

msgid "Remote monitoring"
msgstr "Удалённый мониторинг"

msgid "Runtime"
msgstr "Время работы"

msgid "Runtime low"
msgstr "Минимальное время работы"

msgid "Service disabled"
msgstr "Служба отключена"

msgid "Shutdown mode"
msgstr "Режим выключения"

msgid "Shutdown timer"
msgstr "Таймер выключения"

msgid "Standalone"
msgstr "Автономный"

msgid "Status"
msgstr "Статус"

msgid "Temperature"
msgstr "Температура"

msgid "The name used to uniquely identify your UPS on local or remote system."
msgstr "Имя, используемое для уникальной идентификации вашего ИБП в локальной или удалённой системе."

msgid ""
"The number of power supplies that the UPS feeds on this system (usually 1), "
"refer to <a href='https://networkupstools.org/docs/man/upsmon.conf.html' "
"target='_blank'>upsmon.conf(5)</a> for more information."
msgstr "Количество блоков питания, питаемых от ИБП в этой системе (обычно 1). Дополнительные сведения см. в <a href='https://networkupstools.org/docs/man/upsmon.conf.html' target='_blank'>upsmon.conf(5)</a>."

msgid ""
"The time in seconds until shutdown is initiated. If the UPS happens to come "
"back before the time is up the shutdown is canceled."
msgstr "Время в секундах до выключения системы. Если ИБП восстановит питание до истечения этого времени, выключение будет отменено."

msgid ""
"To get more information how to configure your UPS please check the Network "
"UPS Tools <a href='http://www.networkupstools.org/docs/man/ups.conf.html' "
"target='_blank'>documentation</a>."
msgstr "Чтобы получить дополнительную информацию о настройке ИБП, см. <a href='http://www.networkupstools.org/docs/man/ups.conf.html' target='_blank'>документацию</a> Network UPS Tools."

msgid "UPS"
msgstr "ИБП"

msgid "UPS Battery"
msgstr "Батарея ИБП"

msgid "UPS Information"
msgstr "Сведения об ИБП"

msgid "UPS device and battery information."
msgstr "Сведения об устройстве ИБП и батарее."

msgid "UPS goes on battery"
msgstr "ИБП переходит на питание от батареи"

msgid "UPS reaches low battery"
msgstr "ИБП достигает низкого заряда батареи"

msgid "Updated UPS settings."
msgstr "Настройки ИБП обновлены."

msgid "Used for remote authentication."
msgstr "Используется для удалённой аутентификации."

msgid "User name"
msgstr "Имя пользователя"

msgid "Voltage"
msgstr "Напряжение"
