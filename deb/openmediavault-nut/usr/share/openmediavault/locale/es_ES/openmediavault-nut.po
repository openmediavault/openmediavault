msgid ""
"'Standalone' for local UPS, 'Netclient' for remote UPS on a NUT server."
msgstr "'Standalone' para un SAI local, 'Netclient' para un SAI remoto en un servidor NUT."

msgid "Battery charge with the low-battery shutdown threshold marked."
msgstr "Carga de la batería con el umbral de apagado por batería baja marcado."

msgid "Battery date"
msgstr "Fecha de la batería"

msgid "Battery low"
msgstr "Batería baja"

