msgid ""
"'Standalone' for local UPS, 'Netclient' for remote UPS on a NUT server."
msgstr "Välj ”Fristående” om UPS:en är ansluten till den här datorn eller ”Nätverksklient” om den övervakas via en NUT-server."

msgid "Battery charge with the low-battery shutdown threshold marked."
msgstr "Visar batteriets laddningsnivå och markerar gränsen för avstängning vid låg batterinivå."

msgid "Battery date"
msgstr "Batteriets tillverkningsdatum"

msgid "Battery low"
msgstr "Gräns för låg batterinivå"

msgid "Battery type"
msgstr "Batterityp"

msgid "Battery voltage"
msgstr "Batterispänning"

msgid "Charge"
msgstr "Batterinivå"

msgid "Charge warning"
msgstr "Varningsgräns för batterinivå"

msgid "Comment"
msgstr "Kommentar"

msgid "Date & Time"
msgstr "Datum och tid"

msgid "Defines when the shutdown is initiated."
msgstr "Anger när systemet börjar stängas av."

msgid "Driver configuration directives"
msgstr "Konfigurationsdirektiv för drivrutinen"

msgid "Enable remote monitoring of the local connected UPS."
msgstr "Tillåt fjärrövervakning av den lokalt anslutna UPS:en."

msgid "Enabled"
msgstr "Aktiverad"

msgid "Identifier"
msgstr "Identifierare"

msgid "Input voltage"
msgstr "Inspänning"

msgid "Invalid identifier"
msgstr "Ogiltig identifierare"

msgid "Load"
msgstr "Belastning"

msgid "Low"
msgstr "Gräns för låg nivå"

msgid "Manufacturer"
msgstr "Tillverkare"

msgid "Message"
msgstr "Meddelande"

msgid "Mode"
msgstr "Läge"

msgid "Model"
msgstr "Modell"

msgid "Netclient"
msgstr "Nätverksklient"

msgid "Netclient hostname"
msgstr "NUT-serverns värdnamn"

msgid "Netclient password"
msgstr "Lösenord på NUT-servern"

msgid "Netclient user name"
msgstr "Användarnamn på NUT-servern"

msgid "PID"
msgstr "PID"

msgid "Password"
msgstr "Lösenord"

msgid "Powervalue"
msgstr "Antal nätaggregat som UPS:en försörjer"

msgid "Program"
msgstr "Program"

msgid "Remote monitoring"
msgstr "Fjärrövervakning"

msgid "Runtime"
msgstr "Återstående batteritid"

msgid "Runtime low"
msgstr "Gräns för låg återstående batteritid"

msgid "Service disabled"
msgstr "Tjänst inaktiverad"

msgid "Shutdown mode"
msgstr "Avstängningsläge"

msgid "Shutdown timer"
msgstr "Tidsgräns före avstängning"

msgid "Standalone"
msgstr "Fristående"

msgid "Status"
msgstr "Status"

msgid "Temperature"
msgstr "Temperatur"

msgid "The name used to uniquely identify your UPS on local or remote system."
msgstr "Ett unikt namn för UPS:en på det lokala systemet eller fjärrsystemet."

msgid ""
"The number of power supplies that the UPS feeds on this system (usually 1), "
"refer to <a href='https://networkupstools.org/docs/man/upsmon.conf.html' "
"target='_blank'>upsmon.conf(5)</a> for more information."
msgstr "Antalet nätaggregat i det här systemet som får ström från UPS:en (vanligtvis 1). Mer information finns i <a href='https://networkupstools.org/docs/man/upsmon.conf.html' target='_blank'>upsmon.conf(5)</a>."

msgid ""
"The time in seconds until shutdown is initiated. If the UPS happens to come "
"back before the time is up the shutdown is canceled."
msgstr "Antal sekunder innan systemet börjar stängas av. Om nätströmmen kommer tillbaka innan tiden har gått ut avbryts den planerade avstängningen."

msgid ""
"To get more information how to configure your UPS please check the Network "
"UPS Tools <a href='http://www.networkupstools.org/docs/man/ups.conf.html' "
"target='_blank'>documentation</a>."
msgstr "Mer information om hur UPS-enheten konfigureras finns i <a href='http://www.networkupstools.org/docs/man/ups.conf.html' target='_blank'>dokumentationen för Network UPS Tools</a>."

msgid "UPS"
msgstr "UPS"

msgid "UPS Battery"
msgstr "UPS-batteri"

msgid "UPS Information"
msgstr "UPS-information"

msgid "UPS device and battery information."
msgstr "Information om UPS:en och batteriet."

msgid "UPS goes on battery"
msgstr "UPS-enheten går över till batteridrift"

msgid "UPS reaches low battery"
msgstr "UPS:en når gränsen för låg batterinivå"

msgid "Updated UPS settings."
msgstr "UPS-inställningarna uppdaterades."

msgid "Used for remote authentication."
msgstr "Används för fjärrautentisering."

msgid "User name"
msgstr "Användarnamn"

msgid "Voltage"
msgstr "Spänning"
