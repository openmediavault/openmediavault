msgid "Apply"
msgstr "適用"

msgid "Login"
msgstr "ログイン"

msgid "Page"
msgstr "ページ"

msgid "Reset"
msgstr "リセット"

msgid "Reset the wallpaper to the default image."
msgstr "壁紙をデフォルトの画像にリセットします。"

msgid "Shutdown"
msgstr "シャットダウン"

msgid "Standby"
msgstr "スタンバイ"

msgid "The URL from which the image is to be fetched."
msgstr "イメージ取得元のURLです。"

msgid "The URL must start with http://, https:// or file://."
msgstr "URLは、http://、https://、またはfile://で始まる必要があります。"

msgid "The page for which the wallpaper is to be set."
msgstr "壁紙を設定するページ。"

msgid "The wallpaper has been updated."
msgstr "壁紙が更新されました。"

msgid "URL"
msgstr "URL"

msgid "Wallpaper"
msgstr "壁紙"

msgid "You may need to clear your browser's cache to see your changes."
msgstr "変更内容を反映させるには、ブラウザのキャッシュを消去する必要がある場合があります。"
