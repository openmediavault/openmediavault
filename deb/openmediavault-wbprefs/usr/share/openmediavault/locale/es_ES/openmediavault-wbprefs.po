msgstr "Aplicar"

msgid "Login"
msgstr "Iniciar sesión"

msgid "Page"
msgstr "Página"

msgid "Reset"
msgstr "Restablecer"

msgid "Reset the wallpaper to the default image."
msgstr "Restablecer el fondo de pantalla a la imagen predeterminada."

msgid "Shutdown"
msgstr "Apagar"

msgid "Standby"
msgstr "En espera"

msgid "The URL from which the image is to be fetched."
msgstr "La URL de la cual se va a obtener la imagen."

msgid "The URL must start with http://, https:// or file://."
msgstr "La URL debe comenzar con http://, https:// o file://."

msgid "The page for which the wallpaper is to be set."
msgstr "La página para la cual se va a configurar el fondo de pantalla."

msgid "The wallpaper has been updated."
msgstr "El fondo de pantalla se ha actualizado."

msgid "URL"
msgstr "URL"

msgid "Wallpaper"
msgstr "Fondo de pantalla"

msgid "You may need to clear your browser's cache to see your changes."
msgstr ""
"Es posible que deba borrar la caché de su navegador para ver los cambios."
