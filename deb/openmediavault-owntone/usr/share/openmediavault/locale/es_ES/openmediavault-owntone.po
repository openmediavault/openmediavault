msgstr "Carpeta compartida"

msgid ""
"The location of the media files to share. Make sure the user "
"<em>owntone</em> or group <em>users</em> can access the files."
msgstr ""
"La ubicación de los archivos multimedia para compartir. Asegúrese de que el "
"propio <em>usuario</em> o los usuarios <em>del grupo</em> puedan acceder a "
"los archivos."

msgid "The name of the library as displayed by the clients."
msgstr "El nombre de la biblioteca tal como lo muestran los clientes."

msgid "The password for the user <em>admin</em> to access the web interface."
msgstr ""
"La contraseña para el usuario <em>admin</em> para acceder a la interfaz web."

msgid "The password to access the library."
msgstr "La contraseña para acceder a la biblioteca."

msgid "Updated OwnTone settings."
msgstr "Configuración de OwnTone actualizada."

msgid "Web interface"
msgstr "Interfaz web"
